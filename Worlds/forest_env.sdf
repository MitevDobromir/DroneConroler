<?xml version="1.0" ?>
<!--
  forest_env.sdf  (world name: forest_world)

  Forest scene for obstacle-avoidance testing among natural clutter.
    - Small clear pad (~7 m radius) around spawn (0,0) for takeoff.
    - Oak and Pine trees scattered beyond, denser than the street scene.
    - One Cow hidden inside a tight tree cluster around (13, -8) — mostly
      occluded from the spawn point, so you have to fly in to spot it.

  PREREQUISITE (one time, offline-safe afterwards):
    Run  Scripts/vendor_fuel_models.sh  on the VM (needs internet once).
    It vendors:  Oak tree, Pine Tree, Cow  (and the Ambulance for street_env)
    into ~/ROS2_Tools/Models/ so the include URIs below resolve.

    IMPORTANT — names are case-sensitive. If the script reports the resolved
    name as e.g. "Pine tree" instead of "Pine Tree", update the <uri> tags
    here to match exactly what it prints.

  Conventions copied from obstacle_env.sdf: same plugin set, spherical
  coordinates (ArduPilot home), scene, sun, and 200x200 ground plane.
-->
<sdf version="1.7">
<world name="forest_world">
<physics name="1ms" type="ignored">
<max_step_size>0.001</max_step_size>
<real_time_factor>1.0</real_time_factor>
</physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
  <render_engine>ogre2</render_engine>
</plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
<plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

<spherical_coordinates>
  <latitude_deg>-35.363262</latitude_deg>
  <longitude_deg>149.165237</longitude_deg>
  <elevation>584</elevation>
  <heading_deg>0</heading_deg>
  <surface_model>EARTH_WGS84</surface_model>
</spherical_coordinates>

<scene>
<ambient>0.5 0.55 0.5 1</ambient>
<background>0.75 0.85 0.95 1</background>
<sky>
<clouds><speed>8</speed></clouds>
</sky>
</scene>

<light type="directional" name="sun">
<cast_shadows>true</cast_shadows>
<pose>0 0 10 0 0 0</pose>
<diffuse>0.85 0.85 0.8 1</diffuse>
<specular>0.2 0.2 0.2 1</specular>
<direction>-0.4 0.2 -0.9</direction>
</light>

<!-- Ground plane — earthy green forest floor -->
<model name="ground_plane">
<static>true</static>
<link name="link">
<collision name="collision">
<geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
</collision>
<visual name="visual">
<geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
<material>
<ambient>0.25 0.35 0.18 1</ambient>
<diffuse>0.35 0.45 0.22 1</diffuse>
</material>
</visual>
</link>
</model>

<!-- ============================================ -->
<!-- TREES — scattered oak + pine. Spawn pad      -->
<!-- (~7 m around origin) left clear for takeoff. -->
<!-- ============================================ -->

<include><uri>model://Oak tree</uri><name>oak_01</name><pose>9 3 0 0 0 0.3</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_01</name><pose>12 8 0 0 0 1.1</pose></include>
<include><uri>model://Oak tree</uri><name>oak_02</name><pose>6 11 0 0 0 2.0</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_02</name><pose>-8 6 0 0 0 0.7</pose></include>
<include><uri>model://Oak tree</uri><name>oak_03</name><pose>-12 2 0 0 0 1.6</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_03</name><pose>-10 -7 0 0 0 2.4</pose></include>
<include><uri>model://Oak tree</uri><name>oak_04</name><pose>-6 -12 0 0 0 0.9</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_04</name><pose>4 -14 0 0 0 1.3</pose></include>
<include><uri>model://Oak tree</uri><name>oak_05</name><pose>-15 -14 0 0 0 0.2</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_05</name><pose>-18 8 0 0 0 1.9</pose></include>
<include><uri>model://Oak tree</uri><name>oak_06</name><pose>16 4 0 0 0 0.5</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_06</name><pose>18 -5 0 0 0 2.2</pose></include>
<include><uri>model://Oak tree</uri><name>oak_07</name><pose>-19 -3 0 0 0 1.0</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_07</name><pose>8 17 0 0 0 0.6</pose></include>
<include><uri>model://Oak tree</uri><name>oak_08</name><pose>-4 18 0 0 0 1.5</pose></include>

<!-- Tree cluster concealing the cow (around x=13, y=-8) -->
<include><uri>model://Pine Tree</uri><name>pine_hide_1</name><pose>11 -6 0 0 0 0.4</pose></include>
<include><uri>model://Oak tree</uri><name>oak_hide_1</name><pose>15 -7 0 0 0 1.2</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_hide_2</name><pose>13 -11 0 0 0 2.1</pose></include>
<include><uri>model://Oak tree</uri><name>oak_hide_2</name><pose>10 -9 0 0 0 0.8</pose></include>
<include><uri>model://Pine Tree</uri><name>pine_hide_3</name><pose>16 -10 0 0 0 1.7</pose></include>

<!-- Hidden animal removed for now; re-add an <include> here when ready. -->


</world>
</sdf>
